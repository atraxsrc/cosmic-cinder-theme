# Cinder for delta (the git diff pager), part of cosmic-cinder-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat Cinder theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/cinder.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = cinder

[delta "cinder"]
    dark = true
    syntax-theme = Cinder
    navigate = true
    line-numbers = true

    file-style = bold "#CC6528"
    file-decoration-style = "#383735" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#383735" box
    hunk-header-file-style = "#90947A"
    hunk-header-line-number-style = "#C6C4B0"

    minus-style = "#C75E57" "#1A1A1E"
    minus-emph-style = bold "#121212" "#C75E57"
    minus-non-emph-style = "#C75E57" "#1A1A1E"
    plus-style = "#A5A297" "#1A1A1E"
    plus-emph-style = bold "#121212" "#A5A297"
    plus-non-emph-style = "#A5A297" "#1A1A1E"
    zero-style = syntax
    whitespace-error-style = "#121212" "#E19E74"

    line-numbers-left-style = "#383735"
    line-numbers-right-style = "#383735"
    line-numbers-minus-style = "#C75E57"
    line-numbers-plus-style = "#A5A297"
    line-numbers-zero-style = "#626A78"

    commit-style = bold "#C6C4B0"
    commit-decoration-style = "#383735" box
    blame-palette = "#121212 #1A1A1E #222228"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#A5A297"
    merge-conflict-theirs-diff-header-style = bold "#E19E74"
